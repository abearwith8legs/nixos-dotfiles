[%General]
author = Rowan Wolfe
comment = Cassette-futurist amber ship computer theme
alpha = 0.95
composite = true
translucent_windows = false
blurring = false
contrast = 1.0
intensity = 1.0
saturation = 1.0
spread = 1
left_tabs = false
attach_active_tab = false
group_toggle_button_style = 0
groove_thickness = 4
scroll_arrows = true
scroll_width = 12
slider_width = 14
slider_handle_width = 16
slider_handle_length = 16
menu_shadow_depth = 0
tooltip_shadow_depth = 0
splitter_width = 1
animate_states = false
animate_hover = false
button_icon_size = 16
toolbar_icon_size = 16
list_icon_size = 16
combo_as_lineedit = true
fill_rubberband = true
merge_menubar_with_toolbar = true
layout_spacing = 6
layout_margin = 8
click_behavior = 0

; This file is generated by tools/recolor-kvantum.py alongside a matching
; Ship-Amber.svg -- see that script and the bundle README before this theme
; will actually render. On its own this kvconfig has no visuals attached.
